# -----------------------------------------------------------------------------
# Example environment configuration
#
# Copy public defaults:
#   cp .env.example .env.local
#
# Copy server secrets template:
#   cp .env.example .env.server.local
# then fill in DATABASE_URL, API_KEY_HASH_SECRET, and provider credentials.
#
# RULES:
#   - NEXT_PUBLIC_* values are PUBLIC and may enter the browser bundle.
#   - Never put secrets in NEXT_PUBLIC_*.
#   - Server secrets are validated by src/server/config/env.ts.
# -----------------------------------------------------------------------------

# --- Public (frontend) -------------------------------------------------------
NEXT_PUBLIC_APP_NAME=EV Telemetry Dashboard
NEXT_PUBLIC_APP_ENV=development
# Same-origin Next.js API (backend Route Handlers live in this app).
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
NEXT_PUBLIC_ARC_EXPLORER_BASE_URL=https://testnet.arcscan.app
# Web3Auth Client ID (public). Required for login UI; leave empty to disable.
# Register localhost on Sapphire Devnet: https://dashboard.web3auth.io /
# https://developer.metamask.io/
NEXT_PUBLIC_WEB3AUTH_CLIENT_ID=
NEXT_PUBLIC_WEB3AUTH_NETWORK=sapphire_devnet

# --- Server-only (never NEXT_PUBLIC_*) ---------------------------------------
NODE_ENV=development
APP_ENV=development

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ev_telemetry
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=10000
DATABASE_IDLE_TIMEOUT_MS=20000
DATABASE_STATEMENT_TIMEOUT_MS=30000
DATABASE_SSL_MODE=disable

LOG_LEVEL=info

# At least 32 characters. Generate a unique value per environment.
API_KEY_HASH_SECRET=replace-me-with-a-long-random-secret!!

IDEMPOTENCY_TTL_SECONDS=86400
WEBHOOK_MAX_BODY_BYTES=1048576

TELEMETRY_PRICE_USDC_ATOMIC=400
PAYMENT_REQUIREMENT_TTL_SECONDS=900
PAYMENT_PROTOCOL_VERSION=1.0.0
# Demo-friendly: release after payment even if anchor is still PENDING.
# Use strict only when the worker is running and anchors to ANCHORED first.
PROVENANCE_DELIVERY_MODE=pending

# Agent telemetry rate limit (per authenticated principal)
AGENT_RATE_LIMIT_PER_WINDOW=60
AGENT_RATE_LIMIT_WINDOW_SECONDS=60

# Web3Auth identity verification (server). Client ID is public; defaults to
# NEXT_PUBLIC_WEB3AUTH_CLIENT_ID when unset.
# WEB3AUTH_CLIENT_ID=
# Optional comma-separated JWKS URLs (defaults include citadel + api-auth + authjs)
# WEB3AUTH_JWKS_URLS=

# Circle Gateway / Arc (required for live nanopayments)
# When ALLOW_MOCK_ADAPTERS=false you MUST set a real SELLER_WALLET_ADDRESS
# (demo 0x1111… is rejected).
# SELLER_WALLET_ADDRESS=0x...
# ARC_RPC_URL=https://rpc.testnet.arc.network/<token>
# ARC_CHAIN_ID=5042002
# ARC_USDC_CONTRACT_ADDRESS=0x3600000000000000000000000000000000000000
# CIRCLE_GATEWAY_FACILITATOR_URL=https://gateway-api-testnet.circle.com
# CIRCLE_GATEWAY_AUTH_TOKEN=
# CIRCLE_GATEWAY_WALLET_ADDRESS=0x0077777d7EBA4688BDeF3E311b846F25870A19B9
# ARC_PAYMENT_SIGNER_PRIVATE_KEY=  # demo/dev/test only — forbidden in production
# ARC_GATEWAY_AUTO_DEPOSIT_AMOUNT=1.0
# AGENT_POLL_INTERVAL_SECONDS=30
# AGENT_API_BASE_URL=http://localhost:3000
# AGENT_API_KEY=
# AGENT_WALLET_ADDRESS=
# Optional override — by default agent discovers newest onboarded device:
# AGENT_DEVICE_ID=

ARC_REQUIRED_CONFIRMATIONS=3
# Arc DeviceNFT mint (on vehicle finalize). Requires USE_ARC_NETWORK + token.
# USE_ARC_NETWORK=true
# ARC_AUTH_TOKEN=
# DEVICE_NFT_CONTRACT_ADDRESS=0xf1AB69B6C1eAddCf47C6019805Ac37F2d78FA908
# PRIVATE_KEY=  # ovpp DeviceNFTOwnerWallet — demo/dev only
# DEVICE_NFT_MINTER_PRIVATE_KEY=  # optional override of PRIVATE_KEY
# DEVICE_NFT_TYPE_ID=1
# Preferred live provenance: DeviceNFT.recordDeviceEvent (needs UPDATER_ROLE on same signer).
# BatchAnchor below is fallback only when DeviceNFT mint path is not configured.
# BATCH_ANCHOR_CONTRACT_ADDRESS=0x...
# BATCH_ANCHOR_CONTRACT_VERSION=provisional-anchorContentHash-v1
# BATCH_ANCHOR_SIGNER_PRIVATE_KEY=  # demo/dev/test only — forbidden in production
# BATCH_ANCHOR_SIGNER_KEY_REFERENCE=  # production KMS reference (future)

# Enode (required for vehicle Link onboarding + webhook ingestion)
# ENODE_API_BASE_URL=https://enode-api.sandbox.enode.io
# ENODE_OAUTH_TOKEN_URL=https://oauth.sandbox.enode.io/oauth2/token
# ENODE_API_VERSION=2024-10-01
# ENODE_CLIENT_ID=
# ENODE_CLIENT_SECRET=
# ENODE_REDIRECT_URI=http://localhost:3000/enode/complete
# ENODE_FRONTEND_URL=http://localhost:3000
# ENODE_WEBHOOK_SECRET=
# Comma-separated IPv4 / CIDR allowlist. Empty = no IP filter (HMAC still required).
# ENODE_WEBHOOK_ALLOWED_IPS=203.0.113.10,198.51.100.0/24
# PENDING_DEVICE_OAUTH_TTL_HOURS=24

# Local/dev only. Must be false in staging/production.
# With true, `pnpm agent:dev` uses mock buyer (no ARC_PAYMENT_SIGNER_PRIVATE_KEY).
ALLOW_MOCK_ADAPTERS=true

# Super-admin Basic Auth for /admin (both required to enable; omit to disable).
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=replace-me-with-a-long-password

WORKER_ID=worker-local-1
WORKER_POLL_INTERVAL_MS=1000
WORKER_CONCURRENCY=4
WORKER_MAX_ATTEMPTS=8

# OTEL_EXPORTER_OTLP_ENDPOINT=
# SENTRY_DSN=

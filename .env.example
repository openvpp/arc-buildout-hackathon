# -----------------------------------------------------------------------------
# Example environment configuration
#
# Copy public defaults:
#   cp .env.example .env.local
#
# Copy server secrets template:
#   cp .env.example .env.server.local
# then fill in DATABASE_URL, API_KEY_HASH_SECRET, and provider credentials.
#
# RULES:
#   - NEXT_PUBLIC_* values are PUBLIC and may enter the browser bundle.
#   - Never put secrets in NEXT_PUBLIC_*.
#   - Server secrets are validated by src/server/config/env.ts.
# -----------------------------------------------------------------------------

# --- Public (frontend) -------------------------------------------------------
NEXT_PUBLIC_APP_NAME=EV Telemetry Dashboard
NEXT_PUBLIC_APP_ENV=development
# Same-origin Next.js API (backend Route Handlers live in this app).
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
NEXT_PUBLIC_ARC_EXPLORER_BASE_URL=https://explorer.arc-testnet.example

# --- Server-only (never NEXT_PUBLIC_*) ---------------------------------------
NODE_ENV=development
APP_ENV=development

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ev_telemetry
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=10000
DATABASE_IDLE_TIMEOUT_MS=20000
DATABASE_STATEMENT_TIMEOUT_MS=30000
DATABASE_SSL_MODE=disable

LOG_LEVEL=info

# At least 32 characters. Generate a unique value per environment.
API_KEY_HASH_SECRET=replace-me-with-a-long-random-secret!!

IDEMPOTENCY_TTL_SECONDS=86400
WEBHOOK_MAX_BODY_BYTES=1048576

TELEMETRY_PRICE_USDC_ATOMIC=400
PAYMENT_REQUIREMENT_TTL_SECONDS=900
PAYMENT_PROTOCOL_VERSION=1.0.0
PROVENANCE_DELIVERY_MODE=strict

# Circle Gateway / Arc (required for live nanopayments)
# SELLER_WALLET_ADDRESS=0x...
# ARC_RPC_URL=https://rpc.testnet.arc.network
# ARC_CHAIN_ID=5042002
# ARC_USDC_CONTRACT_ADDRESS=0x3600000000000000000000000000000000000000
# CIRCLE_GATEWAY_FACILITATOR_URL=https://gateway-api-testnet.circle.com
# CIRCLE_GATEWAY_AUTH_TOKEN=
# CIRCLE_GATEWAY_WALLET_ADDRESS=0x0077777d7EBA4688BDeF3E311b846F25870A19B9
# ARC_PAYMENT_SIGNER_PRIVATE_KEY=  # demo/dev/test only — forbidden in production
# ARC_GATEWAY_AUTO_DEPOSIT_AMOUNT=1.0
# AGENT_POLL_INTERVAL_SECONDS=30
# AGENT_API_BASE_URL=http://localhost:3000
# AGENT_API_KEY=
# AGENT_WALLET_ADDRESS=
# AGENT_DEVICE_ID=

ARC_REQUIRED_CONFIRMATIONS=3
# BATCH_ANCHOR_CONTRACT_ADDRESS=0x...
# BATCH_ANCHOR_CONTRACT_VERSION=
# BATCH_ANCHOR_SIGNER_KEY_REFERENCE=

# Enode (required before enabling webhook ingestion)
# ENODE_API_BASE_URL=https://enode-api.example
# ENODE_API_VERSION=
# ENODE_CLIENT_ID=
# ENODE_CLIENT_SECRET=
# ENODE_WEBHOOK_SECRET=
# ENODE_WEBHOOK_ALLOWED_IPS=

# Local/dev only. Must be false in staging/production.
ALLOW_MOCK_ADAPTERS=true

WORKER_ID=worker-local-1
WORKER_POLL_INTERVAL_MS=1000
WORKER_CONCURRENCY=4
WORKER_MAX_ATTEMPTS=8

# OTEL_EXPORTER_OTLP_ENDPOINT=
# SENTRY_DSN=

# Copy to .env.local for local development. Never commit real values.

# --- App ---
APP_ENV=development
LOG_LEVEL=info
# Must stay false in production and staging. The app has no mock
# adapter path; startup rejects true outside local/test environments.
ALLOW_MOCK_ADAPTERS=false

# --- Database (PostgreSQL via Drizzle) ---
DATABASE_URL=postgres://arc_buildout:arc_buildout@localhost:5432/arc_buildout
TEST_DATABASE_URL=postgres://arc_buildout:arc_buildout@localhost:5432/arc_buildout_test
DATABASE_SSL_MODE=disable

# --- Session signing ---
# 32+ random characters. Required at that length when APP_ENV is
# production or staging. Signs the httpOnly dashboard session JWT.
API_KEY_HASH_SECRET=

# --- Sign-in (Circle DCW popup) ---
# Optional. The sign-in popup uses email and password. This client id is
# only used if a Google ID token is submitted to the session route.
NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=552237701392-s1bi3jg32e55gfqp8lcr4knjaou5nvi3.apps.googleusercontent.com

# --- Circle Developer-Controlled Wallets (server-only) ---
CIRCLE_API_KEY=
CIRCLE_ENVIRONMENT=sandbox
CIRCLE_ENTITY_SECRET=
CIRCLE_WALLET_SET_ID=
CIRCLE_WALLET_BLOCKCHAIN=ARC-TESTNET

# --- Enode ---
ENODE_API_BASE_URL=https://enode-api.sandbox.enode.io
ENODE_OAUTH_TOKEN_URL=https://oauth.sandbox.enode.io/oauth2/token
ENODE_API_VERSION=2024-10-01
ENODE_CLIENT_ID=
ENODE_CLIENT_SECRET=
ENODE_REDIRECT_URI=http://localhost:3000/enode/complete
ENODE_FRONTEND_URL=http://localhost:3000
ENODE_WEBHOOK_SECRET=
PENDING_DEVICE_OAUTH_TTL_HOURS=1

# --- Arc network / DeviceNFT mint ---
USE_ARC_NETWORK=false
# Optional. Defaults to Arc's public RPC for ARC_CHAIN_ID
# (rpc.testnet.arc.io / rpc.mainnet.arc.io), which is rate-limited — set a
# provider URL for production traffic.
ARC_RPC_URL=https://rpc.testnet.arc.io
ARC_AUTH_TOKEN=
# Optional separate RPC used only for independent verification reads.
VERIFIER_RPC_URL=
# Writers whose anchors verification accepts (comma-separated). Defaults to
# this app's own signer; the contract lets any UPDATER_ROLE holder write.
ARC_TRUSTED_WRITER_ADDRESSES=
# Anchors later than this after the activity are flagged with a warning.
VERIFICATION_MAX_ANCHOR_DELAY_HOURS=24
# Optional explorer API for discovering past events (defaults to the
# chain's Blockscout /api; the mainnet one may block server requests).
ARC_EXPLORER_API_URL=
# 5042002 = Arc testnet, 5042 = Arc mainnet. NEXT_PUBLIC_ARC_CHAIN_ID must
# match (the server refuses to start otherwise). On mainnet,
# CIRCLE_WALLET_BLOCKCHAIN must be the mainnet chain.
ARC_CHAIN_ID=5042002
NEXT_PUBLIC_ARC_CHAIN_ID=5042002
# Optional; defaults to the explorer for NEXT_PUBLIC_ARC_CHAIN_ID.
NEXT_PUBLIC_ARC_EXPLORER_BASE_URL=https://explorer.testnet.arc.io
DEVICE_NFT_CONTRACT_ADDRESS=0xf1AB69B6C1eAddCf47C6019805Ac37F2d78FA908
# Base signer key; DEVICE_NFT_MINTER_PRIVATE_KEY optionally overrides it for minting only.
PRIVATE_KEY=
DEVICE_NFT_MINTER_PRIVATE_KEY=
# typeId is resolved from devices.device_type via device-types.ts, not
# configured here — see that file for the on-chain taxonomy.
ARC_REQUIRED_CONFIRMATIONS=3

# --- Charging cost (configured tariff, not a measured price) ---
ELECTRICITY_PRICE_USD_PER_KWH=0.12

# --- Mapbox (device globe) ---
NEXT_PUBLIC_MAPBOX_TOKEN=
# Server-side geocoding of device addresses (falls back to the public token).
MAPBOX_GEOCODING_TOKEN=
# Mapbox only permits storing results requested with permanent=true (billed).
# Set true in any environment that stores real addresses.
MAPBOX_PERMANENT_GEOCODING=false
# Seeds the stable 0.5–2 km offset on public globe pins (defaults to
# API_KEY_HASH_SECRET). Changing it moves live-location pins.
LOCATION_OBFUSCATION_SECRET=

# --- Worker ---
WORKER_ID=local
WORKER_POLL_INTERVAL_MS=2000
WORKER_MAX_ATTEMPTS=5

# --- Admin console (/admin) ---
# Fixed username `Admin`. Admin123 is the local demo password only:
# staging/production refuse it (and any password under 12 characters).
ADMIN_PASSWORD=Admin123

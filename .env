# -----------------------------------------------------------------------------
# Committed PUBLIC defaults.
#
# Every value here is public, non-secret NEXT_PUBLIC_* configuration, committed
# so the boilerplate builds and runs with zero setup. Validated by
# src/config/env.ts at startup.
#
# NEVER put a secret in this file. Override values locally with `.env.local`
# (git-ignored). Server secrets go in `.env.server.local` / process env —
# see `.env.example` and `src/server/config/env.ts`.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=EV Telemetry Dashboard
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
NEXT_PUBLIC_ARC_EXPLORER_BASE_URL=https://explorer.arc-testnet.example

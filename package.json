{
  "name": "ev-telemetry-nanopayment-dashboard",
  "version": "0.1.0",
  "private": true,
  "description": "EV telemetry nanopayment marketplace — Next.js dashboard, Circle Gateway backend, worker, and demo agent in one monorepo.",
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.0.8",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node --env-file-if-exists=.env.local ./node_modules/next/dist/bin/next start",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --project unit",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:backend": "pnpm test:unit && pnpm test:integration",
    "test:watch": "vitest",
    "test:coverage": "vitest run --project unit --coverage",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env.local ./node_modules/tsx/dist/cli.mjs scripts/migrate.ts",
    "db:check": "drizzle-kit check",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx scripts/seed-demo.ts",
    "demo:inject-telemetry": "tsx scripts/inject-demo-telemetry.ts",
    "demo:dummy-webhook": "node --env-file-if-exists=.env.local ./node_modules/tsx/dist/cli.mjs scripts/send-dummy-enode-webhook.ts",
    "db:reset:test": "tsx scripts/reset-test-database.ts",
    "worker:dev": "node --env-file-if-exists=.env.local ./node_modules/tsx/dist/cli.mjs watch src/worker/index.ts",
    "worker:start": "node --env-file-if-exists=.env.local ./node_modules/tsx/dist/cli.mjs src/worker/index.ts",
    "agent:dev": "node --env-file-if-exists=.env.local ./node_modules/tsx/dist/cli.mjs watch src/agent/index.ts",
    "agent:start": "node --env-file-if-exists=.env.local ./node_modules/tsx/dist/cli.mjs src/agent/index.ts",
    "services:up": "docker compose up -d",
    "services:down": "docker compose down",
    "services:logs": "docker compose logs -f",
    "openapi:generate": "tsx scripts/generate-openapi.ts",
    "openapi:check": "tsx scripts/check-openapi.ts",
    "verify:env": "tsx scripts/verify-environment.ts",
    "validate": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "validate:backend": "pnpm db:check && pnpm lint && pnpm typecheck && pnpm test:backend && pnpm openapi:check && pnpm build",
    "prepare": "husky"
  },
  "dependencies": {
    "@circle-fin/x402-batching": "3.2.0",
    "@tanstack/react-query": "5.101.4",
    "@web3auth/modal": "11.3.0",
    "@x402/core": "2.20.0",
    "@x402/evm": "2.20.0",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.2",
    "jose": "6.2.8",
    "next": "16.2.12",
    "pino": "10.3.1",
    "postgres": "3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "tailwind-merge": "3.6.0",
    "viem": "2.55.10",
    "wagmi": "3.7.6",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@tanstack/react-query-devtools": "5.101.4",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/coverage-v8": "4.1.10",
    "@vitest/eslint-plugin": "1.6.25",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.12",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-playwright": "2.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-testing-library": "7.16.2",
    "eslint-plugin-unused-imports": "4.4.1",
    "globals": "17.9.0",
    "husky": "9.1.7",
    "jsdom": "30.0.1",
    "lint-staged": "17.3.0",
    "pino-pretty": "13.1.3",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  }
}
